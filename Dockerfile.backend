FROM python:3.10-slim

# Install only minimal system dependencies (glib and ffmpeg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the uv binary from the official astral-sh image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy python project definition and lock file
COPY pyproject.toml uv.lock ./

# Sync dependencies (creates the virtual environment .venv and installs packages)
RUN uv sync --frozen

# Replace opencv-python with opencv-python-headless inside the virtual environment
RUN uv pip install opencv-python-headless

# Copy backend files
COPY backend/ ./backend/

# Expose port 8000 (internally)
EXPOSE 8000

# Run the backend FastAPI app inside the virtual environment using uv run
CMD ["uv", "run", "python", "backend/app.py"]
