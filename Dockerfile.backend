FROM python:3.10-slim

# Install only minimal system dependencies (glib and ffmpeg)
# We use apt-get update with retries to handle temporary network issues
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

# Pre-install headless OpenCV so pip install . doesn't pull the GUI version
RUN pip install --no-cache-dir opencv-python-headless

# Copy python project definition and install dependencies
COPY pyproject.toml ./
RUN pip install --no-cache-dir .

# Copy backend files
COPY backend/ ./backend/

# Expose port 8000 (internally)
EXPOSE 8000

# Run the backend FastAPI app
CMD ["python", "backend/app.py"]
